# =========================================================
# Next.js Website Builder & Refero Theme Engine
# Environment Configuration (.env.example)
# =========================================================

# 1. AI Generation Provider (OpenRouter Free Tier)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# 2. Whop License Validation
# It verifies license keys via Whop's API (https://api.whop.com/v5/licenses/{key}).
WHOP_API_KEY=

# 3. Upstash Redis (Free Database to prevent key reuse & piracy)
# Get free at https://console.upstash.com -> Create Database -> Scroll down to "REST API" -> Click ".env"
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Default Demo/Master license key for testing during development:
MASTER_LICENSE_KEY=WHOP-CLEAN-PRO-2026
